# =============================================================================
# dkt_connectome — .gitignore
#
# Strategy: track CODE (Snakefile, rules, scripts, configs, docs); ignore DATA
# (BIDS inputs, derivatives, work dirs, caches, logs, container images).
# =============================================================================

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.env

# --- Editors / OS -------------------------------------------------------------
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# --- Snakemake state (per-run, regenerated) -----------------------------------
.snakemake/
report.html
dag.svg
*.log

# --- Slurm / driver logs (large, regenerated every run) -----------------------
logs/
*.out
*.err
slurm-*.out
slurm-*.err

# --- Pipeline outputs (large; live outside the repo or in results/) -----------
results/
derivatives/

# Local TBI test I/O (BIDS + RESULTS_ROOT under dwi_pipeline/dwi_test_TBI/).
# Track only the layout README.
/dwi_pipeline/dwi_test_TBI/**
!/dwi_pipeline/dwi_test_TBI/README.md

# IDEAS II sample BIDS (OpenNeuro ds007401) — downloaded NIfTI, not committed.
/dwi_pipeline/sample_data/ideas/bids/**
!/dwi_pipeline/sample_data/ideas/README.md
!/dwi_pipeline/sample_data/ideas/SUBJECTS.md
!/dwi_pipeline/sample_data/README.md

# --- Container images (huge, distributed separately) --------------------------
*.sif
*.img
*.simg
containers/*.sif

# --- Container build scratch (staged ANTs / MRtrix / FreeSurfer binaries) -----
dwi_pipeline/containers/connectome/build_ctx/
dwi_pipeline/containers/connectome/build_ctx_lean/
dwi_pipeline/containers/connectome/.apptainer_tmp/
dwi_pipeline/containers/connectome/.fs_min_test/
dwi_pipeline/containers/connectome/.fs_min_out/
**/apptainer_tmp/
**/apptainer_cache/
*.tar
*.tar.gz

# --- User-specific configs / subject lists (never commit private data) --------
config/subjects.tsv
config/*.local.yaml
config/*.private.yaml
config/myconfig*.yaml

# --- Cached templates / atlases -----------------------------------------------
/templateflow/
.cache/

# --- Local datasets mounted or symlinked in for processing --------------------
# Add your own dataset directories here. Nothing under them should be tracked.
/*_BIDS/
/*_bids/
/bids/
/data/
/datasets/
/Two_Time_Points/

# --- Vendored upstream projects (not our code) --------------------------------
/dwi_minimum_preprocessing-master/

# =============================================================================
# Pipeline outputs / intermediate results / work directories
# (anything QSIPrep / QSIRecon / FreeSurfer / FastSurfer / Step 4 writes)
# =============================================================================

# Legacy top-level run outputs from earlier exploration
/dwi_phase1/
/intermediate_results/
/intermediate_results_recon/
/intermediate_results_run1/
/intermediate_results_run2/
/intermediate_results_separate/
/qsiprep_output/
/qsiprep_run1_output/
/qsiprep_run2_output/
/qsiprep_separate_output/
/qsiprep_merged_output/
/qsirecon_output/
/test_bids_fmap_no_sidecars/

# Generic patterns for any future result dirs at any depth
**/qsiprep_*_output/
**/qsirecon_*_output/
**/qsirecon_single_run_output/
**/qsiprep_single_run_output/
**/freesurfer/sub-*/
**/connectomes/sub-*/
**/.flags/
**/work/
**/_work_qsiprep_*/
**/_work_qsirecon_*/

# Derived per-subject artefacts written alongside code (small but generated)
/extracted_csv_samples/
/online_extracts/
qsiprep_qsirecon_subject_status.csv

# Backups
backups/
*.bak

# Atlas-only connectome wrapper (lives locally, not in this repo)
/dwi_connect_default/

# Generated documentation artefacts. The markdown is the source; regenerate with
# scripts/md_to_docx.py (.docx) and scripts/make_brain_figures.py (figures).
# These are tracked so the documents render on GitHub, which is only safe
# because every figure is rendered from public templates (fsaverage, MNI152)
# rather than from participants. Do not commit figures built from study data.
/dwi_pipeline/figures/**/.cache/

# Real study identifiers must not reach the public repository. Subject lists and
# the per-subject scan-parameter table stay local; the tracked template and
# defaults carry placeholder IDs only.
/dwi_pipeline/subjects_*.txt
/dwi_pipeline/subject_list_urmc_*.txt
!/dwi_pipeline/subject_list_urmc_*.example.txt
/dwi_pipeline/config/bids_repair_subjects.local.csv

# --- Report figures (per-subject, derived from real study data) ---------------
# The visualization CODE in dwi_pipeline/reports/scripts/ is tracked; every
# per-subject output folder it writes into is not. Do not commit figures,
# volumes, or draft reports built from participant data.
/dwi_pipeline/reports/sub-*/

# venv_enigma_vtk is a full python venv (~1.7GB, incl. a pinned VTK build) --
# see dwi_pipeline/reports/scripts/README.md to rebuild it locally, never commit it.
/dwi_pipeline/reports/scripts/venv_enigma_vtk/

# TemplateFlow cache (download at runtime; do not commit)
dwi_pipeline/templateflow/

# MkDocs build output (regenerate with mkdocs build)
dwi_pipeline/site/

# Local reference papers / repair configs with real subject IDs (never commit)
dwi_pipeline/Inpainting/
dwi_pipeline/ENIGMA.docx
dwi_pipeline/flag.docx
dwi_pipeline/sample_software_paper/*.pdf
dwi_pipeline/sample_software_paper/*.docx
dwi_pipeline/config/bids_repair_phase2_rsfmap.json
dwi_pipeline/workflow/config/config.local.yaml
