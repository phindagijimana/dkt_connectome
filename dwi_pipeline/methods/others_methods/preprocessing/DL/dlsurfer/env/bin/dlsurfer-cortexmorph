#!/usr/bin/env bash
# CortexMorph thickness (SCAN-NRAD) — literature Ready pick in DL-CTE family
# (Wu DL-CTE GitHub is empty; CortexMorph has public weights).
set -euo pipefail
usage() {
  echo "Usage: dlsurfer-cortexmorph --sd SUBJECTS_DIR --sid SID --out OUT [--device cuda|cpu]"
}
SD="" SID="" OUT="" DEVICE="cuda"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sd) SD="$2"; shift 2 ;;
    --sid) SID="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --device) DEVICE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
[[ -n "$SD" && -n "$SID" && -n "$OUT" ]] || { usage; exit 2; }
CM_ROOT="${CORTEXMORPH_ROOT:-/mnt/nfs/home/urmc-sh.rochester.edu/pndagiji/Documents/others/CortexMorph}"
DLS="$(cd "$(dirname "$0")/../.." && pwd)"
mkdir -p "$OUT"
export CORTEXMORPH_ROOT="$CM_ROOT" SUBJECTS_DIR="$SD" DLSURFER_SID="$SID" DLSURFER_OUT="$OUT" DLSURFER_DEVICE="$DEVICE"
python3 "${DLS}/scripts/run_cortexmorph_subject.py"
