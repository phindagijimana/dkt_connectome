# Copy to config.local.yaml and fill in real paths for this machine.
# config.local.yaml is gitignored — never commit personal NFS paths.
#
#   cp config.local.yaml.example config.local.yaml
#
# Pin containers to tested upstream tags (build/pull .sif from these):
container_pins:
  qsiprep: pennlinc/qsiprep:1.0.0
  qsirecon: pennlinc/qsirecon:1.2.1
  freesurfer: freesurfer/freesurfer:7.4.1
  fastsurfer: deepmi/fastsurfer:latest
  connectome: ghcr.io/phindagijimana/dk-connectome:0.1.0
  vbt: ghcr.io/phindagijimana/dkt-vbt:0.1.0
  lesion_act: ghcr.io/phindagijimana/dkt-lesion-act:0.1.0
  lit: deepmi/lit:0.6.0
  nodestrength: phindagijimana321/nodestrength:0.1.0

containers:
  qsiprep: /path/to/others/containers/qsiprep.sif
  qsirecon: /path/to/others/containers/qsirecon.sif
  fastsurfer: /path/to/others/containers/fastsurfer_latest.sif
  freesurfer: /path/to/others/containers/freesurfer_7.4.1.sif
  connectome: /path/to/others/containers/dkt_connectome.sif
  vbt: /path/to/others/containers/dkt_vbt.sif
  lesion_act: /path/to/others/containers/dkt_lesion_act.sif
  lit: /path/to/others/containers/lit_0.6.0.sif
  nodestrength: /path/to/node_strength/containers/nodestrength_0.1.0.sif

fs_license: /path/to/others/data_mining/freesurfer/license.txt

# Optional: validate BIDS before every run
# bids:
#   validate: true

# Local TBI test layout example:
# bids_dir: /path/to/dwi_pipeline/dwi_test_TBI/bids
# results_root: /path/to/dwi_pipeline/dwi_test_TBI/sub-TBI011011_fastsurfer_inpaint
