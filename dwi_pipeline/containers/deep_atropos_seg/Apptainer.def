Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Philbert Ndagijimana
    Version 0.1.0
    Description ANTsPyNet Deep Atropos segmentation on native T1w

%environment
    export PYTHONUNBUFFERED=1
    export ANTSXNET_CACHE=/opt/antsxnet_cache
    export PATH=/usr/bin:/bin

%files
    run_deep_atropos_seg.py /opt/deep_atropos_seg/run_deep_atropos_seg.py
    run_deep_atropos_seg.sh /usr/local/bin/run_deep_atropos_seg
    antsxnet_cache /opt/antsxnet_cache

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-pip libgomp1 \
    && pip3 install --no-cache-dir \
        numpy==1.26.4 nibabel==5.2.1 scipy==1.11.4 \
        ants==0.4.2 antspynet==0.2.7 \
    && rm -rf /var/lib/apt/lists/*
    chmod +x /usr/local/bin/run_deep_atropos_seg
    mkdir -p /opt/antsxnet_cache

%runscript
    exec /usr/local/bin/run_deep_atropos_seg "$@"
