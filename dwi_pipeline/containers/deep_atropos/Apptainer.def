Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Philbert Ndagijimana
    Version 0.1.0
    Description Deep Atropos seg to native-T1 5TT (MRtrix from qsirecon.sif)

%environment
    export LD_LIBRARY_PATH=/opt/mrtrix3-latest/lib
    export PATH=/opt/mrtrix3-latest/bin:/usr/bin:/bin

%files
    mrtrix3-latest /opt/mrtrix3-latest
    convert_deep_atropos_to_5tt.py /opt/deep_atropos/convert_deep_atropos_to_5tt.py
    run_deep_atropos_5tt.sh /usr/local/bin/run_deep_atropos_5tt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates python3 python3-pip libgomp1 libgfortran5 zlib1g \
        libtiff5 libpng16-16 libfftw3-double3 \
    && pip3 install --no-cache-dir nibabel numpy \
    && rm -rf /var/lib/apt/lists/*
    chmod +x /usr/local/bin/run_deep_atropos_5tt

%runscript
    exec /usr/local/bin/run_deep_atropos_5tt "$@"
