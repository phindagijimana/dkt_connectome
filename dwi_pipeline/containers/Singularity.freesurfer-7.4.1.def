# =============================================================================
# Singularity / Apptainer definition for a full FreeSurfer 7.4.1 image.
#
# This SIF is dedicated to FreeSurfer (recon-all and friends). It is built
# from an Ubuntu 22.04 base and copies the full on-disk FreeSurfer 7.4.1
# install (with all atlases, including RB_all_withskull_2020_01_02.gca that
# fastsurfer_latest.sif ships without) into /opt/freesurfer.
#
# Build (on a compute node — login /tmp is noexec):
#     sbatch dwi_pipeline/containers/build_freesurfer_sif.sbatch
#
# Output:
#     /mnt/nfs/.../others/containers/freesurfer_7.4.1.sif  (~25 GB)
#
# Sanity check:
#     apptainer exec freesurfer_7.4.1.sif recon-all -version
#     apptainer exec freesurfer_7.4.1.sif ls /opt/freesurfer/average/RB_all_withskull_2020_01_02.gca
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: build

%files
    /mnt/nfs/home/urmc-sh.rochester.edu/pndagiji/Documents/others/data_mining/freesurfer  /opt/freesurfer

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # recon-all + ancillary tool runtime deps (matches NeuroDocker's FS recipe)
    apt-get install -y --no-install-recommends \
        bc \
        ca-certificates \
        curl \
        file \
        gfortran \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libglu1-mesa \
        libgomp1 \
        libice6 \
        libjpeg-turbo8 \
        libsm6 \
        libtbb12 \
        libx11-6 \
        libxext6 \
        libxft2 \
        libxi6 \
        libxmu6 \
        libxrandr2 \
        libxrender1 \
        libxt6 \
        locales \
        perl \
        python3 \
        python3-pip \
        tcsh \
        unzip \
        zlib1g
    locale-gen en_US.UTF-8
    rm -rf /var/lib/apt/lists/*

    # Sanity: license + a known atlas file must be present after %files
    [ -f /opt/freesurfer/license.txt ] || echo "WARNING: license.txt missing inside image"
    [ -f /opt/freesurfer/average/RB_all_withskull_2020_01_02.gca ] \
        || { echo "FATAL: skull-stripping GCA missing"; exit 1; }
    [ -x /opt/freesurfer/bin/recon-all ] \
        || { echo "FATAL: recon-all binary missing"; exit 1; }

%environment
    export OS=Linux
    export FREESURFER_HOME=/opt/freesurfer
    export FREESURFER=/opt/freesurfer
    export SUBJECTS_DIR=/opt/freesurfer/subjects
    export FUNCTIONALS_DIR=/opt/freesurfer/sessions
    export MNI_DIR=/opt/freesurfer/mni
    export FSL_DIR=/opt/freesurfer/fsl
    export FSFAST_HOME=/opt/freesurfer/fsfast
    export MINC_BIN_DIR=/opt/freesurfer/mni/bin
    export MINC_LIB_DIR=/opt/freesurfer/mni/lib
    export MNI_DATAPATH=/opt/freesurfer/mni/data
    export MNI_PERL5LIB=/opt/freesurfer/mni/share/perl5
    export PERL5LIB=/opt/freesurfer/mni/share/perl5
    export PATH=/opt/freesurfer/bin:/opt/freesurfer/fsfast/bin:/opt/freesurfer/tktools:/opt/freesurfer/mni/bin:$PATH
    export FS_OVERRIDE=0
    export FIX_VERTEX_AREA=
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8

%test
    /opt/freesurfer/bin/recon-all -version
    test -f /opt/freesurfer/average/RB_all_withskull_2020_01_02.gca

%labels
    Maintainer    pndagiji
    FreeSurfer    7.4.1
    BuildSource   on-disk install at /mnt/nfs/.../others/data_mining/freesurfer
    Purpose       Standalone full FreeSurfer for the DWI pipeline recon step

%help
    Full FreeSurfer 7.4.1 with all atlases. Usage:
        apptainer exec --cleanenv --containall \
            -B BIDS:/bids:ro -B SUBJECTS_DIR:/sd \
            -B /path/to/license.txt:/opt/freesurfer/license.txt:ro \
            freesurfer_7.4.1.sif \
            bash -lc 'export FS_LICENSE=/opt/freesurfer/license.txt;
                      export SUBJECTS_DIR=/sd;
                      recon-all -all -s sub-XXX -i /bids/.../T1w.nii.gz -openmp 8'
