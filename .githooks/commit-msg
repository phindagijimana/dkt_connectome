#!/bin/sh
# Strip Co-authored-by trailers. Exit 0 always.
# Policy: docs/commit_attribution.md

msg_file=$1
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  exit 0
fi

tmp=${msg_file}.dkt-hook
grep -viE '^[[:space:]]*Co-[Aa]uthored-[Bb]y:' "$msg_file" > "$tmp" || true
mv "$tmp" "$msg_file"
exit 0
